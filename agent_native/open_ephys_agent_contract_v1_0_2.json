  },
  "transport": {
    "http_base_url": "http://127.0.0.1:37497",
    "uia": "windows_uia"
  },
  "scope": "core",
  "api": {
    "route_source": "agent_native/open_ephys_agent_surface.json",
    "command_count": 33,
    "parameter_response": {
      "required_fields": [
        "name",
        "type",
        "value",
        "key",
        "display_name",
        "description",
        "enabled",
        "deactivate_during_acquisition",
        "uia.automation_id"
      ],
      "route_lookup_field": "name",
      "stable_identity_field": "key"
    },
    "stream_response": {
      "required_fields": [
        "name",
        "source_id",
        "sample_rate",
        "channel_count",
        "parameters",
        "stream_index",
        "runtime_id",
        "source_name",
        "description",
        "identifier",
        "generates_timestamps",
        "identity.available",
        "identity.scope",
        "identity.source_id",
        "identity.identifier",
        "uia.automation_id",
        "uia.scope",
        "uia.uses_display_name_fallback"
      ],
      "route_lookup_field": "stream_index",
      "identity": {
        "fields": ["source_id", "identifier"],
        "available_when": "identifier_nonempty",
        "scope": "configuration"
      },
      "non_durable_fields": {
        "stream_index": "current_configuration_order",
        "runtime_id": "process_lifetime"
      }
    },
    "typed_tools": {
      "oe_list_streams": {
        "backend_command": "get_processor",
        "readback": "response.streams"
      },
      "oe_get_stream": {
        "backend_command": "get_stream",
        "readback": "response"
      }
    },
    "parameter_name_segment_policy": {
      "field": "parameter_name",
      "source": "parameter_response.name",
      "input": "raw",
      "render": "percent_encode_utf8_once",
      "reject": ["empty", "slash", "backslash", "dot_segment", "control_character"]
    },
    "required_routes": [
      {
        "command": "get_capabilities",
        "method": "GET",
        "path": "/api/capabilities",
        "capability": "oe.capabilities"
      },
      {
        "command": "get_status",
        "method": "GET",
        "path": "/api/status",
        "capability": "oe.control.acquisition"
      },
      {
        "command": "set_mode",
        "method": "PUT",
        "path": "/api/status",
        "capability": "oe.control.acquisition"
      },
      {
        "command": "get_recording",
        "method": "GET",
        "path": "/api/recording",
        "capability": "oe.control.recording.directory"
      },
      {
        "command": "set_recording",
        "method": "PUT",
        "path": "/api/recording",
        "capability": "oe.control.recording.directory"
      },
      {
        "command": "list_processors",
        "method": "GET",
        "path": "/api/processors",
        "capability": "oe.processors"
      },
      {
        "command": "get_processor",
        "method": "GET",
        "path": "/api/processors/{processor_id}",
        "capability": "oe.processor"
      },
      {
        "command": "get_stream",
        "method": "GET",
        "path": "/api/processors/{processor_id}/streams/{stream_index}",
        "capability": "oe.processor.stream"
      },
      {
        "command": "get_processor_parameters",
        "method": "GET",
        "path": "/api/processors/{processor_id}/parameters",
        "capability": "oe.processor.parameters"
      },
      {
        "command": "get_parameter",
        "method": "GET",
        "path": "/api/processors/{processor_id}/parameters/{parameter_name}",
        "capability": "oe.processor.parameter"
      },
      {
        "command": "set_parameter",
        "method": "PUT",
        "path": "/api/processors/{processor_id}/parameters/{parameter_name}",
        "capability": "oe.processor.parameter"
      },
      {
        "command": "get_stream_parameter",
        "method": "GET",
        "path": "/api/processors/{processor_id}/streams/{stream_index}/parameters/{parameter_name}",
        "capability": "oe.processor.stream.parameter"
      },
      {
        "command": "set_stream_parameter",
        "method": "PUT",
        "path": "/api/processors/{processor_id}/streams/{stream_index}/parameters/{parameter_name}",
        "capability": "oe.processor.stream.parameter"
      }
    ]
  },
  "uia": {
    "root_id": "oe.window.main",
    "parameter_automation_id_rule": "oe.parameter.<sanitised parameter key>",
    "processor_catalog_automation_id_rule": "oe.processor_catalog.<sanitised processor slug>",
    "stream_row_automation_id_rule": "oe.processor.<processor_id>.streams.table.source_<source_id>.stream_<sanitised identifier-or-display-name>[.index_<nonnegative stream_index on collision>]",
