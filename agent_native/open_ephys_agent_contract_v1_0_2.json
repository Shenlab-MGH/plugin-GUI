{
  "schema_version": "0.1.3",
  "contract": {
    "id": "open-ephys-agent",
    "version": "0.1.3",
    "fixture": "open_ephys_agent_contract_v1_0_2.json"
  },
  "baseline": {
    "upstream": "open-ephys/plugin-GUI",
    "version": "1.0.2",
