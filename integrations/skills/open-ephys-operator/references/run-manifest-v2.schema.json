{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ephys-agent.local/schema/run-manifest-v0.0.2.json",
  "title": "Open Ephys Agent complete eight-part run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "subject_id", "operator", "protocol_id",
    "created_at_utc", "experiment_root", "archive_root", "hardware",
    "storage", "stream_expectations", "qc_policy", "authorizations", "parts"
  ],
  "properties": {
    "schema_version": {"const": "oe-agent-run-manifest/v0.0.2"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operator": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "experiment_root": {"type": "string", "minLength": 3, "maxLength": 1024},
    "archive_root": {"type": "string", "minLength": 3, "maxLength": 1024},
    "hardware": {"$ref": "#/$defs/hardware"},
    "storage": {"$ref": "#/$defs/storage"},
    "stream_expectations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/stream"}
    },
    "qc_policy": {"$ref": "#/$defs/qc"},
    "authorizations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/authorization"}
    },
    "parts": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "$defs": {
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["gui_version", "pxi_plugin_version", "imec_api_version", "onebox_serial", "probe_serial", "slot", "port", "dock", "reference"],
      "properties": {
        "gui_version": {"type": "string"}, "pxi_plugin_version": {"type": "string"},
        "imec_api_version": {"type": "string"}, "onebox_serial": {"type": "string"},
        "probe_serial": {"type": "string"}, "slot": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 0}, "dock": {"type": "integer", "minimum": 0},
        "reference": {"type": "string"}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_free_bytes", "reserve_bytes", "poll_interval_seconds"],
      "properties": {
        "minimum_free_bytes": {"type": "integer", "exclusiveMinimum": 0},
        "reserve_bytes": {"type": "integer", "exclusiveMinimum": 0},
        "poll_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60}
      }
    },
    "stream": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "channel_count", "sample_rate_hz", "recording_enabled", "events_required", "timestamps_required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "channel_count": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"type": "number", "exclusiveMinimum": 0},
        "recording_enabled": {"const": true},
        "events_required": {"type": "boolean"},
        "timestamps_required": {"type": "boolean"}
      }
    },
    "qc": {
      "type": "object", "additionalProperties": false,
      "required": ["criteria_id", "scientist_review_required"],
      "properties": {
        "criteria_id": {"type": "string", "minLength": 1},
        "scientist_review_required": {"const": true}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "scope", "approver", "expires_at_utc"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 1},
        "scope": {"const": "SUPERVISED_COMPLETE_RUN"},
        "approver": {"type": "string", "minLength": 1},
        "expires_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["part_index", "preset", "electrode_start", "electrode_end", "target_duration_seconds", "duration_tolerance_seconds", "maximum_overrun_seconds", "settling_seconds", "directory_name"],
      "properties": {
        "part_index": {"type": "integer", "minimum": 1, "maximum": 8},
        "preset": {"type": "string", "minLength": 1},
        "electrode_start": {"type": "integer", "minimum": 1},
        "electrode_end": {"type": "integer", "minimum": 1},
        "target_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "duration_tolerance_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
        "maximum_overrun_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "settling_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "directory_name": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
